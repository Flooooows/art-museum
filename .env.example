# Copier ce fichier en `.env` (ignoré par Git) et y coller votre clé.
# Clé API OpenAI : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modèle d’image (facultatif). Les pochettes actuelles ont été générées avec gpt-image-2 ;
# gpt-image-1-mini coûte environ 3 fois moins cher (gpt-image-1 n’est plus proposé).
OPENAI_IMAGE_MODEL=gpt-image-2
