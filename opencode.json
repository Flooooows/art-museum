{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    { "action": "plugin.use", "resource": "*impeccable*", "effect": "deny" },
    { "action": "mcp.use", "resource": "*impeccable*", "effect": "deny" },
    { "action": "skill.use", "resource": "*impeccable*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated"
        ]
      }
    }
  }
}
