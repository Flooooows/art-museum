        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/review-data/catalog.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/masterpieces-data/catalog.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/enrichment-351-data/catalog.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
