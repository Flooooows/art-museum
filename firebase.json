{
  "hosting": {
    "site": "art-museum-8fdd8-atelier",
    "public": "dist-atelier",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "review-351.html"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
