{
  "name": "muse-art-booster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:lab": "vite --config vite.muse-lab.config.ts --open /muse-lab.html",
    "build:lab": "tsc --noEmit && vite build --config vite.muse-lab.config.ts && tsx scripts/muse-lab/prepare-hosting.ts",
    "preview:lab": "vite preview --config vite.muse-lab.config.ts",
    "deploy:lab": "npm run build:lab && npx --yes --package firebase-tools@15.34.2 firebase deploy --only hosting --config firebase.lab.json --project muse-lab-6f2d --non-interactive",
    "dev:opening-lab": "vite --host 127.0.0.1 --port 4179 --open /opening-lab.html",
    "booster-lab:prepare": "tsx scripts/booster-lab/prepare.ts",
    "dev:booster-lab": "vite --config vite.booster-lab.config.ts --open /booster-lab.html",
    "build:booster-lab": "tsc --noEmit && vite build --config vite.booster-lab.config.ts",
    "preview:booster-lab": "vite preview --config vite.booster-lab.config.ts",
    "card-lab:prepare": "tsx scripts/card-lab/prepare.ts",
    "card-lab:prepare-frames": "tsx scripts/card-lab/prepare-frames.ts && tsx scripts/card-lab/prepare-generated-frames.ts && tsx scripts/card-lab/prepare-refined-frames.ts && tsx scripts/card-lab/prepare-prestige-frames.ts && tsx scripts/card-lab/prepare-themed-frames.ts && tsx scripts/card-lab/prepare-museum-frames.ts && tsx scripts/card-lab/prepare-decorative-frames.ts && tsx scripts/card-lab/prepare-frieze-palette.ts && tsx scripts/card-lab/prepare-frieze-frames.ts",
    "card-lab:prepare-refined": "tsx scripts/card-lab/prepare-refined-frames.ts",
    "card-lab:prepare-prestige": "tsx scripts/card-lab/prepare-prestige-frames.ts",
    "card-lab:prepare-themed": "tsx scripts/card-lab/prepare-themed-frames.ts",
    "card-lab:prepare-museum": "tsx scripts/card-lab/prepare-museum-frames.ts",
    "card-lab:prepare-decorative": "tsx scripts/card-lab/prepare-decorative-frames.ts",
    "card-lab:prepare-frieze": "tsx scripts/card-lab/prepare-frieze-palette.ts && tsx scripts/card-lab/prepare-frieze-frames.ts",
    "card-lab:prepare-generated": "tsx scripts/card-lab/prepare-generated-frames.ts",
    "card-lab:audit": "tsx scripts/card-lab/audit-assignments.ts",
    "dev:card-lab": "vite --config vite.card-lab.config.ts --open /card-lab.html",
    "build:card-lab": "tsc --noEmit && vite build --config vite.card-lab.config.ts",
    "preview:card-lab": "vite preview --config vite.card-lab.config.ts",
    "taxonomy:build": "tsx scripts/catalog-taxonomy/build.ts",
    "taxonomy:check": "tsx scripts/catalog-taxonomy/audit.ts",
    "game:prepare": "tsx scripts/game-release/prepare.ts",
    "game:expand:2026-11-01": "tsx scripts/game-release/expand-2026-11-01.ts",
    "game:check": "tsx scripts/game-release/audit.ts",
    "legal:build": "tsx scripts/legal-eu/build.ts",
    "legal:check": "tsx scripts/legal-eu/build.ts --check",
    "prepare:frames": "node scripts/prepare-frames.mjs",
    "catalog:check": "tsx scripts/audit-catalog.ts",
    "catalog:images": "tsx scripts/audit-image-rights.ts",
    "catalog:notoriety": "tsx scripts/report-notoriety.ts",
    "rarity:v2:collect": "tsx scripts/rarity-v2/collect.ts",
    "rarity:v2": "tsx scripts/rarity-v2/run.ts",
    "rarity:v2:verify": "tsx scripts/rarity-v2/verify.ts",
    "review:collect": "tsx scripts/review/collect.ts",
    "review:build": "tsx scripts/review/build.ts",
    "masterpieces:audit": "tsx scripts/masterpieces/audit.ts",
    "masterpieces:build": "tsx scripts/masterpieces/build.ts",
    "masterpieces:images": "tsx scripts/masterpieces/images.ts",
    "enrichment:prepare": "tsx scripts/enrichment-351/prepare.ts",
    "enrichment:images": "tsx scripts/enrichment-351/images.ts",
    "enrichment:build": "tsx scripts/enrichment-351/build.ts",
    "build:atelier": "npm run legal:check && vite build --config vite.atelier.config.ts && tsx scripts/prepare-atelier-hosting.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "check": "npm run typecheck && npm test && npm run catalog:check && npm run catalog:images && npm run legal:check && npm run game:check && npm run taxonomy:check",
    "preview:atelier": "vite preview --config vite.atelier.config.ts --host 127.0.0.1",
    "deploy:atelier": "npm run build:atelier && firebase deploy --only hosting --project art-museum-8fdd8",
    "deploy:muse": "npm run build && npx --yes --package firebase-tools firebase deploy --only hosting --config firebase.muse.json --project muse-collection-6f2d --non-interactive",
    "dev": "vite",
    "build": "npm run catalog:check && npm run catalog:images && npm run legal:check && npm run game:check && npm run taxonomy:check && tsc -b && vite build && tsx scripts/game-presentation/prepare-hosting.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
