      "**/.*",
      "**/node_modules/**",
      "review.html",
      "review-data/**",
      "masterpieces-data/**",
      "masterpieces-images/**",
      "enrichment-351-data/**",
      "enrichment-351-images/**",
      "review-351.html"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
