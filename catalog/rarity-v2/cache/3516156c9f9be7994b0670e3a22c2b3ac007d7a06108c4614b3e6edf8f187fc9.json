                    "P1683": [
                      {
                        "snaktype": "value",
                        "property": "P1683",
                        "hash": "c6471cf3c2c2c74b39a608509b64d7fd8928e974",
                        "datavalue": {
                          "value": {
                            "text": "Well-known for his talent for uncovering neglected masterpieces, Derek Johns supplies the world's leading museums and private collections. Among his most notable discoveries are Francisco Goya’s 1804 full-length Portrait of the Marquesa de Santiago and Dieric Bouts’s The Annunciation, both at the Getty Museum, Annibale Carracci’s Boy Drinking now at the Cleveland Museum of Art and a late Canaletto of a View of Piazza San Marco today at LACMA.",
                            "language": "en"
                          },
